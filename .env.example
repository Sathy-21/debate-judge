# Copy to .env for local dev. On Vercel, set these under Project Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: require a passcode so strangers with the link can't spend your API credits
APP_PASSCODE=
# Optional: models and thinking effort
JUDGE_MODEL=claude-opus-5-5
JUDGE_EFFORT=medium
ANNOUNCER_MODEL=claude-sonnet-5-5
# Optional: free-fight limits (need an Upstash Redis database)
OWNER_CODE=
FREE_FIGHTS=2
NETWORK_FIGHTS_PER_DAY=10
KV_REST_API_URL=
KV_REST_API_TOKEN=
